rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{email} {
      // Self-read
      allow read: if request.auth != null && request.auth.token.email == email;

      // Superusers pueden leer todos los documentos
      allow read: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.role == 'superuser';

      // Solo el superusuario raíz (jorge) gestiona accesos (no puede tocar su propio doc raíz)
      allow write: if request.auth != null
        && request.auth.token.email == 'jorge.mendoza@sozu.com'
        && email != 'jorge.mendoza@sozu.com';

      // Bootstrap: jorge.mendoza@sozu.com puede crear su propio documento si no existe
      allow create: if request.auth != null
        && request.auth.token.email == 'jorge.mendoza@sozu.com'
        && email == 'jorge.mendoza@sozu.com'
        && request.resource.data.role == 'superuser';
    }

    // Teléfonos de WhatsApp de contribuidores de GitHub.
    // Cualquier usuario autenticado (registrado en /users) puede leer y escribir.
    match /contributors/{login} {
      allow read, write: if request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.token.email));
    }

    // Grupos de contribuidores (agrupación para analítica).
    // Lectura: cualquier usuario registrado. Escritura: solo el root.
    match /contributor_groups/{id} {
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.token.email));
      allow write: if request.auth != null
        && request.auth.token.email == 'jorge.mendoza@sozu.com';
    }

    // Proyectos y repositorios monitoreados.
    // Lectura: cualquier usuario registrado. Escritura: solo superusers (admins).
    match /projects/{id} {
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.token.email));
      allow write: if request.auth != null
        && request.auth.token.email == 'jorge.mendoza@sozu.com';
    }
    match /repos/{id} {
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.token.email));
      allow write: if request.auth != null
        && request.auth.token.email == 'jorge.mendoza@sozu.com';
    }
  }
}
