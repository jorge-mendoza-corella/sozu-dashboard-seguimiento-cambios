rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{email} {
      // Cualquier usuario autenticado puede leer su propio documento
      allow read: if request.auth != null && request.auth.token.email == email;

      // Solo superusers pueden escribir, y nunca sobre el superusuario principal
      allow write: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.role == 'superuser'
        && email != 'jorge.mendoza@sozu.com';

      // Superusers pueden leer todos los documentos de usuarios
      allow read: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.role == 'superuser';
    }
  }
}
